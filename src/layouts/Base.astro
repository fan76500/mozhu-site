---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleDate?: string;
  articleTags?: string[];
  canonicalURL?: string;
}

const {
  title,
  description,
  ogImage,
  ogType,
  articleDate,
  articleTags,
  canonicalURL,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      articleDate={articleDate}
      articleTags={articleTags}
      canonicalURL={canonicalURL}
    />
  </head>
  <body class="bg-background text-text-primary antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
