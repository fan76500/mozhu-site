---
import Layout from '../layouts/Layout.astro';

const skills = [
  { category: 'Frontend', items: ['React', 'Vue', 'TypeScript', 'Tailwind CSS', 'Next.js'] },
  { category: 'Backend', items: ['Node.js', 'Python', 'FastAPI', 'PostgreSQL', 'MongoDB'] },
  { category: 'Tools', items: ['Git', 'Docker', 'AWS', 'Vercel', 'Figma'] },
];

const timeline = [
  {
    year: '2024',
    title: '高级前端工程师',
    company: '某科技公司',
    description: '负责公司核心产品的前端架构设计与开发，推动技术选型和团队协作。',
  },
  {
    year: '2022',
    title: '全栈开发工程师',
    company: '创业公司',
    description: '从零搭建公司技术栈，独立完成多个项目的全栈开发。',
  },
  {
    year: '2020',
    title: '前端开发工程师',
    company: '某互联网公司',
    description: '参与多个大型项目的前端开发，积累丰富的实战经验。',
  },
  {
    year: '2019',
    title: '计算机科学专业毕业',
    company: '某大学',
    description: '主修 Web 开发方向，毕业设计获得优秀评级。',
  },
];
---

<Layout title="关于我" description="了解我的背景、技能和经验">
  <section class="py-20">
    <div class="container-custom max-w-4xl">
      <div class="text-center mb-16">
        <h1 class="text-4xl sm:text-5xl font-bold text-text-primary mb-4">
          关于<span class="heading-gradient">我</span>
        </h1>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mb-20">
        <div class="lg:col-span-1">
          <div class="sticky top-24">
            <div class="relative">
              <div class="absolute -inset-4 bg-gradient-to-r from-accent-cyan to-accent-indigo rounded-2xl opacity-20 blur-xl"></div>
              <div class="relative rounded-2xl overflow-hidden border-2 border-border">
                <img
                  src="https://placehold.co/400x500/18181b/00d9ff?text=Photo"
                  alt="个人照片"
                  class="w-full"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-text-primary mb-6">你好！</h2>
          <div class="space-y-4 text-text-secondary leading-relaxed">
            <p>
              我是一名热爱技术的全栈开发者，专注于构建现代 Web 应用程序。
              从第一次编写"Hello World"开始，我就被编程世界的无限可能所吸引。
            </p>
            <p>
              在过去的几年里，我有幸参与了多个从初创公司到大型企业的项目，
              涵盖了电商、社交媒体、数据可视化等多个领域。这些经历让我深刻理解
              了如何将业务需求转化为优雅的技术解决方案。
            </p>
            <p>
              我相信好的代码不仅要能运行，还要易于维护、测试和扩展。
              我始终坚持学习新技术，追求代码质量和用户体验的极致。
            </p>
            <p>
              在工作之余，我喜欢写技术博客分享知识，也喜欢探索开源项目，
              为社区贡献自己的一份力量。如果你有任何问题或合作意向，
              欢迎随时联系我！
            </p>
          </div>

          <div class="mt-8">
            <a href="/resume.pdf" download class="btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              下载简历
            </a>
          </div>
        </div>
      </div>

      <section class="mb-20">
        <h2 class="text-2xl font-bold text-text-primary mb-8 text-center">
          技术<span class="heading-gradient">栈</span>
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {skills.map((group) => (
            <div class="card">
              <h3 class="text-lg font-semibold text-text-primary mb-4">
                {group.category}
              </h3>
              <div class="flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <span class="px-3 py-1 text-sm bg-accent-cyan/10 text-accent-cyan rounded-full">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-text-primary mb-8 text-center">
          工作<span class="heading-gradient">经历</span>
        </h2>

        <div class="space-y-8">
          {timeline.map((item, index) => (
            <div class="relative pl-8 border-l-2 border-border">
              <div class="absolute left-0 top-0 w-4 h-4 -translate-x-[9px] rounded-full bg-accent-cyan border-4 border-background"></div>
              
              <div class="card ml-4">
                <div class="flex items-center gap-4 mb-2">
                  <span class="px-3 py-1 text-xs font-medium bg-accent-indigo/10 text-accent-indigo rounded">
                    {item.year}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-text-primary mb-1">
                  {item.title}
                </h3>
                <p class="text-accent-cyan text-sm mb-2">
                  {item.company}
                </p>
                <p class="text-text-secondary text-sm leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-20 text-center">
        <div class="card max-w-2xl mx-auto">
          <h2 class="text-2xl font-bold text-text-primary mb-4">
            联系我
          </h2>
          <p class="text-text-secondary mb-8">
            对我的作品感兴趣或有合作意向？期待与你的交流！
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="mailto:hello@example.com" class="btn-primary">
              发送邮件
            </a>
            <a href="https://github.com/username" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              GitHub
            </a>
            <a href="https://linkedin.com/in/username" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              LinkedIn
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>
</Layout>
