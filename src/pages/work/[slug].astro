---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/ui/Tag.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await project.render();

const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const currentIndex = allProjects.findIndex((p) => p.slug === project.slug);
const prevProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;
const nextProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;

const formattedDate = project.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={project.data.title}
  description={project.data.summary}
  ogType="article"
  articleDate={project.data.date.toISOString()}
  articleTags={project.data.tags}
  canonicalURL={`/work/${project.slug}`}
>
  <article class="py-20">
    <div class="container-custom max-w-4xl">
      <header class="mb-12">
        <a
          href="/work"
          class="inline-flex items-center text-text-secondary text-sm hover:text-accent-cyan transition-colors mb-8"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          返回作品集
        </a>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary mb-6">
          {project.data.title}
        </h1>

        <div class="flex flex-wrap gap-2 mb-6">
          {project.data.tags.map((tag) => (
            <Tag name={tag} variant="cyan" />
          ))}
        </div>

        <p class="text-text-secondary text-lg leading-relaxed mb-8">
          {project.data.summary}
        </p>

        <div class="flex flex-wrap gap-4">
          {project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
              GitHub
            </a>
          )}
          {project.data.liveUrl && project.data.liveUrl.trim() !== '' && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              在线演示
            </a>
          )}
        </div>
      </header>

      {project.data.coverImage && (
        <div class="aspect-video rounded-xl overflow-hidden bg-card-bg mb-12 border border-border">
          <img
            src={project.data.coverImage}
            alt={project.data.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <div class="prose prose-invert prose-lg max-w-none
                  prose-headings:text-text-primary
                  prose-p:text-text-secondary
                  prose-a:text-accent-cyan prose-a:no-underline hover:prose-a:underline
                  prose-code:text-accent-cyan prose-code:bg-card-bg prose-code:px-2 prose-code:py-1 prose-code:rounded
                  prose-pre:bg-card-bg prose-pre:border prose-pre:border-border
                  prose-li:text-text-secondary
                  prose-strong:text-text-primary">
        <Content />
      </div>

      {headings.length > 2 && (
        <aside class="mt-16 p-6 bg-card-bg rounded-xl border border-border">
          <h3 class="text-lg font-semibold text-text-primary mb-4">目录</h3>
          <nav class="space-y-2">
            {headings
              .filter((h) => h.depth <= 3)
              .map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class={`block text-sm text-text-secondary hover:text-accent-cyan transition-colors ${
                    heading.depth === 2 ? '' : heading.depth === 3 ? 'ml-4' : ''
                  }`}
                >
                  {heading.text}
                </a>
              ))}
          </nav>
        </aside>
      )}

      <nav class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevProject && (
          <a
            href={`/work/${prevProject.slug}`}
            class="group card flex items-start gap-4 no-underline"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-1 text-text-secondary group-hover:text-accent-cyan transition-colors">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
            <div class="min-w-0">
              <span class="text-xs text-text-secondary">上一个项目</span>
              <p class="text-text-primary font-medium truncate group-hover:text-accent-cyan transition-colors">
                {prevProject.data.title}
              </p>
            </div>
          </a>
        )}
        {nextProject && (
          <a
            href={`/work/${nextProject.slug}`}
            class="group card flex items-start justify-end gap-4 text-right no-underline sm:col-start-2"
          >
            <div class="min-w-0">
              <span class="text-xs text-text-secondary">下一个项目</span>
              <p class="text-text-primary font-medium truncate group-hover:text-accent-cyan transition-colors">
                {nextProject.data.title}
              </p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-1 text-text-secondary group-hover:text-accent-cyan transition-colors">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>
        )}
      </nav>

      <footer class="mt-16 pt-8 border-t border-border">
        <div class="flex items-center justify-between text-sm text-text-secondary">
          <time datetime={project.data.date.toISOString()}>
            发布于 {formattedDate}
          </time>
          <a
            href="/work"
            class="hover:text-accent-cyan transition-colors"
          >
            ← 返回作品集
          </a>
        </div>
      </footer>
    </div>
  </article>
</Layout>
