---
const navItems = [
  { label: '首页', href: '/' },
  { label: '作品集', href: '/work' },
  { label: '博客', href: '/blog' },
  { label: '关于', href: '/about' },
];

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-lg border-b border-border">
  <nav class="container-custom">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="text-xl font-bold heading-gradient">
        Dev<span class="text-text-primary">Portfolio</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors link-hover ${
              pathname === item.href
                ? 'text-accent-cyan'
                : 'text-text-secondary hover:text-text-primary'
            }`}
          >
            {item.label}
          </a>
        ))}
      </div>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-text-secondary hover:text-text-primary transition-colors"
        aria-label="打开菜单"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-4">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors ${
              pathname === item.href
                ? 'text-accent-cyan'
                : 'text-text-secondary hover:text-text-primary'
            }`}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
