---
interface Props {
  href: string;
  title: string;
  description: string;
  tags: string[];
  coverImage?: string;
  slug: string;
}

const { href, title, description, tags, coverImage, slug } = Astro.props;
---

<a href={href} class="group card block overflow-hidden">
  {coverImage && (
    <div class="aspect-[16/10] overflow-hidden rounded-lg mb-4 bg-background">
      <img
        src={coverImage}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  )}

  <div class="flex flex-wrap gap-2 mb-3">
    {tags.slice(0, 3).map((tag) => (
      <span class="px-2 py-1 text-xs font-medium bg-accent-cyan/10 text-accent-cyan rounded">
        {tag}
      </span>
    ))}
  </div>

  <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-accent-cyan transition-colors">
    {title}
  </h3>

  <p class="text-text-secondary text-sm leading-relaxed line-clamp-2">
    {description}
  </p>
</a>
