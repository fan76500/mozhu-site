---
interface Props {
  name: string;
  variant?: 'cyan' | 'indigo';
}

const { name, variant = 'cyan' } = Astro.props;

const colorClass = variant === 'cyan' 
  ? 'bg-accent-cyan/10 text-accent-cyan' 
  : 'bg-accent-indigo/10 text-accent-indigo';
---

<span class={`inline-block px-3 py-1 text-xs font-medium rounded-full ${colorClass}`}>
  {name}
</span>
